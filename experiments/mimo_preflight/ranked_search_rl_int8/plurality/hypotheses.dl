// Standalone unique plurality of matching-source successors copy circuit; abstains without sufficient support.
.decl guard(g:number,k:number,m:number)
guard(1,1,1).
guard(2,1,2).
guard(3,1,3).
guard(4,1,4).
guard(5,2,1).
guard(6,2,2).
guard(7,2,3).
guard(8,2,4).
guard(9,3,1).
guard(10,3,2).
guard(11,3,3).
guard(12,3,4).
guard(13,4,1).
guard(14,4,2).
guard(15,4,3).
guard(16,4,4).
guard(17,5,1).
guard(18,5,2).
guard(19,5,3).
guard(20,5,4).
guard(21,6,1).
guard(22,6,2).
guard(23,6,3).
guard(24,6,4).
guard(25,7,1).
guard(26,7,2).
guard(27,7,3).
guard(28,7,4).
guard(29,8,1).
guard(30,8,2).
guard(31,8,3).
guard(32,8,4).
guard(33,9,1).
guard(34,9,2).
guard(35,9,3).
guard(36,9,4).
guard(37,10,1).
guard(38,10,2).
guard(39,10,3).
guard(40,10,4).
guard(41,11,1).
guard(42,11,2).
guard(43,11,3).
guard(44,11,4).
guard(45,12,1).
guard(46,12,2).
guard(47,12,3).
guard(48,12,4).
.decl copy_length(k:number)
copy_length(K) :- guard(_,K,_).
// Runtime copy primitive. Includer supplies tok(inst,pos,id) and copy_length(k).
// Match the current k-token suffix, choose the most recent earlier match, copy its successor.
.decl copy_last(inst:number,p:number)
copy_last(I,P) :- tok(I,_,_), P = max Q : { tok(I,Q,_) }.
.decl copy_match(inst:number,j:number,k:number)
copy_match(I,J,1) :- copy_last(I,P), tok(I,P,X), tok(I,J,X), J < P.
copy_match(I,J,K+1) :- copy_match(I,J,K), copy_length(L), K < L,
                      copy_last(I,P), tok(I,P-K,X), tok(I,J-K,X).
.decl copy_source(k:number,inst:number,j:number)
copy_source(K,I,J) :- copy_length(K), copy_match(I,_,K), J = max Q : { copy_match(I,Q,K) }.
.decl copy_prediction(k:number,inst:number,out:number)
copy_prediction(K,I,T) :- copy_source(K,I,J), tok(I,J+1,T).
// Includer supplies copy_core.dl and guard(id, suffix_length, minimum_sources).
// Predict the unique most frequent successor among all exact suffix matches.
// Abstain when support is too small or the top successor is tied.
.decl guard_source(g:number,inst:number,j:number,out:number)
guard_source(G,I,J,T) :- guard(G,K,_), copy_match(I,J,K), tok(I,J+1,T).

.decl guard_vote(g:number,inst:number,out:number,n:number)
guard_vote(G,I,T,N) :- guard_source(G,I,_,T),
                        N = count : { guard_source(G,I,_,T) }.

.decl guard_top(g:number,inst:number,out:number,n:number)
guard_top(G,I,T,N) :- guard_vote(G,I,T,N),
                      N = max M : { guard_vote(G,I,_,M) }.

.decl guard_tie(g:number,inst:number,out:number,n:number)
guard_tie(G,I,T,N) :- guard_vote(G,I,T,N), guard_vote(G,I,Other,N), Other != T.

.decl guard_unique_top(g:number,inst:number,out:number,n:number)
guard_unique_top(G,I,T,N) :- guard_top(G,I,T,N),
                             !guard_tie(G,I,T,N).

.decl guard_prediction(g:number,inst:number,out:number)
guard_prediction(G,I,T) :- guard(G,_,M), guard_unique_top(G,I,T,N), N >= M.

.decl cdecide(inst:number,out:number)
cdecide(I,T) :- guard_prediction(_,I,T).
