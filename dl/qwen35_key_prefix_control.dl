.decl dimension(d:number) .input dimension
.decl context(i:number) .input context
.decl expected(i:number,d:number,v:float) .input expected
.decl actual(i:number,d:number,v:float) .input actual
.decl magnitude(i:number,d:number,v:float)
magnitude(I,D,V) :- expected(I,D,V), V >= 0.0.
magnitude(I,D,-V) :- expected(I,D,V), V < 0.0.
.decl bad(i:number,d:number) .output bad
bad(I,D) :- expected(I,D,V), actual(I,D,W), magnitude(I,D,M), V-W > 0.002+0.002*M.
bad(I,D) :- expected(I,D,V), actual(I,D,W), magnitude(I,D,M), W-V > 0.002+0.002*M.
.decl invalid() .output invalid
invalid() :- !context(_).
invalid() :- context(I), dimension(D), !actual(I,D,_).
invalid() :- context(I), dimension(D), !expected(I,D,_).
invalid() :- actual(I,D,V), actual(I,D,W), V != W.
.decl certified() .output certified
certified() :- !invalid(), !bad(_,_).
