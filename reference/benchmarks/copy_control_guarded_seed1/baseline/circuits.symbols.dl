gram13_hit(I,T) :- mp(I,P), tok(I,P11,C0), tok(I,P10,C1), tok(I,P9,C2), tok(I,P8,C3), tok(I,P7,C4), tok(I,P6,C5), tok(I,P5,C6), tok(I,P4,C7), tok(I,P3,C8), tok(I,P2,C9), tok(I,P1,C10), tok(I,P,C11), P1=P-1, P2=P-2, P3=P-3, P4=P-4, P5=P-5, P6=P-6, P7=P-7, P8=P-8, P9=P-9, P10=P-10, P11=P-11, gram13(C0,C1,C2,C3,C4,C5,C6,C7,C8,C9,C10,C11,T).
gram13_any(I) :- gram13_hit(I,_).
cdecide(I,T) :- gram13_hit(I,T).
