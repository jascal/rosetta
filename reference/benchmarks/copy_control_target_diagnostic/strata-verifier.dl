// Evaluation/audit over a frozen candidate; equivalence is separately certified by equiv.dl.
.decl tok(inst:number,pos:number,id:number) .input tok
.decl ref(inst:number,out:number) .input ref
.decl sample(inst:number,group:symbol,part:symbol,context_hash:symbol) .input sample
#include "circuit.dl"
.decl invalid(inst:number) .output invalid
invalid(I) :- sample(I,_,_,_), !ref(I,_).
invalid(I) :- ref(I,A), ref(I,B), A != B.
invalid(I) :- ref(I,_), !sample(I,_,_,_).
invalid(I) :- tok(I,_,_), !sample(I,_,_,_).
invalid(I) :- cdecide(I,_), !sample(I,_,_,_).
invalid(I) :- cdecide(I,A), cdecide(I,B), A != B.
invalid(I) :- sample(I,G,_,_), sample(I,G2,_,_), G != G2.
invalid(I) :- sample(I,_,S,_), sample(I,_,S2,_), S != S2.
invalid(I) :- sample(I,_,_,H), sample(I,_,_,H2), H != H2.
.decl leakage(inst:number) .output leakage
leakage(I) :- sample(I,G,A,_), sample(_,G,B,_), A != B.
leakage(I) :- sample(I,_,A,H), sample(_,_,B,H), A != B.
.decl part(s:symbol)
part(S) :- sample(_,_,S,_).
.decl answered(inst:number)
answered(I) :- sample(I,_,_,_), cdecide(I,_).
.decl wrong(inst:number)
wrong(I) :- cdecide(I,C), ref(I,R), C != R.
.decl correct(inst:number)
correct(I) :- answered(I), ref(I,_), !wrong(I).
.decl abstain(inst:number) .output abstain
abstain(I) :- sample(I,_,_,_), !answered(I).
.decl score(part:symbol,n:number,answered:number,correct:number,wrong:number,abstained:number) .output score
score(S,N,A,C,W,U) :- part(S),
    N = count : { sample(_,_,S,_) },
    A = count : { sample(I,_,S,_), answered(I) },
    C = count : { sample(I,_,S,_), correct(I) },
    W = count : { sample(I,_,S,_), wrong(I) },
    U = count : { sample(I,_,S,_), abstain(I) }.
.decl ninvalid(n:number) .output ninvalid
ninvalid(N) :- N = count : { invalid(_) }.
.decl nleak(n:number) .output nleak
nleak(N) :- N = count : { leakage(_) }.
.decl certified() .output certified
certified() :- sample(_,_,_,_), ninvalid(0), nleak(0).
// Append to holdout.dl. Buckets are preregistered experimental metadata, not circuit inputs.
.decl bucket(inst:number,factor:symbol,value:symbol) .input bucket
invalid(I) :- bucket(I,_,_), !sample(I,_,_,_).
invalid(I) :- bucket(I,F,A), bucket(I,F,B), A != B.
.decl stratum(factor:symbol,value:symbol)
stratum(F,V) :- bucket(_,F,V).
.decl breakdown(factor:symbol,value:symbol,n:number,answered:number,correct:number,wrong:number,abstained:number)
.output breakdown
breakdown(F,V,N,A,C,W,U) :- stratum(F,V),
    N = count : { bucket(_,F,V) },
    A = count : { bucket(I,F,V), answered(I) },
    C = count : { bucket(I,F,V), correct(I) },
    W = count : { bucket(I,F,V), wrong(I) },
    U = count : { bucket(I,F,V), abstain(I) }.
.decl counterexample(inst:number,model:number,circuit:number) .output counterexample
counterexample(I,R,C) :- ref(I,R), cdecide(I,C), R != C.
// Append to holdout.dl + holdout_strata.dl. Audit paired interventions and report oracle responses.
.decl pair(base:number,edited:number) .input pair
.decl changed(base:number,edited:number,pos:number,replacement:number) .input changed
invalid(B) :- pair(B,E), sample(B,G,S,_), !sample(E,G,S,_).
invalid(B) :- pair(B,_), !sample(B,_,_,_).
invalid(B) :- pair(B,E), !changed(B,E,_,_).
invalid(B) :- changed(B,E,_,_), !pair(B,E).
invalid(B) :- changed(B,E,P,X), !tok(E,P,X).
invalid(B) :- changed(B,E,P,_), !tok(B,P,_).
invalid(B) :- changed(B,E,P,X), tok(B,P,X).
invalid(B) :- pair(B,E), tok(B,P,_), !tok(E,P,_).
invalid(B) :- pair(B,E), tok(E,P,_), !tok(B,P,_).
invalid(B) :- pair(B,E), tok(B,P,X), tok(E,P,Y), X != Y, !changed(B,E,P,Y).
// Every edit is a copied-from successor, and every matching successor is edited.
invalid(B) :- changed(B,_,P,_), !guard_source(_,B,P-1,_).
invalid(B) :- pair(B,E), guard_source(_,B,J,_), !changed(B,E,J+1,_).
.decl pair_result(base:number,edited:number,status:symbol) .output pair_result
pair_result(B,E,"recovered") :- pair(B,E), wrong(B), correct(E).
pair_result(B,E,"regressed") :- pair(B,E), correct(B), wrong(E).
pair_result(B,E,"both_correct") :- pair(B,E), correct(B), correct(E).
pair_result(B,E,"both_wrong") :- pair(B,E), wrong(B), wrong(E).
pair_result(B,E,"unanswered") :- pair(B,E), !answered(B).
pair_result(B,E,"unanswered") :- pair(B,E), !answered(E).
.decl paired_count(original:number,replacement:number,status:symbol,n:number) .output paired_count
paired_count(X,Y,S,N) :- pair_result(B,E,S), cdecide(B,X), cdecide(E,Y),
                       N = count : { pair_result(BB,EE,S), cdecide(BB,X), cdecide(EE,Y) }.
