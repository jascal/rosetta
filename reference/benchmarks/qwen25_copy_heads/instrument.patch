+    fn probe_heads(&self, ids: &[i64], probe: &crate::model::HeadProbe)
+        -> Option<crate::model::HeadProbeResult> {
+        let vocab = self.b.config[6] as usize;
+        if ids.is_empty() || ids.iter().any(|&t| t < 0 || t as usize >= vocab)
+            || probe.heads.iter().any(|&(l,h)| l >= self.n_layer || h >= self.h)
+            || probe.readouts.iter().any(|&t| t >= vocab) {
+            return None;
+        }
+        let mut heads = std::collections::HashSet::new();
+        let mut readouts = std::collections::HashSet::new();
+        if probe.heads.iter().any(|&h| !heads.insert(h))
+            || probe.readouts.iter().any(|&t| !readouts.insert(t)) {
+            return None;
+        }
+        let values = self.logits_ablated(ids, &probe.heads, &[])?;
+        let next = values.iter().enumerate().max_by(|a,b| a.1.partial_cmp(b.1).unwrap())?.0;
+        Some(crate::model::HeadProbeResult {
+            next: next as i64, next_logit: values[next],
+            logits: probe.readouts.iter().map(|&t| (t, values[t])).collect(),
+            scope: "all_positions",
+        })
+    }
