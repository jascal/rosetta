.decl pg_option(c:number,minmatch:number,support:number)
pg_option(4,24,3).
.decl lg_option(c:number,minmatch:number,support:number)
lg_option(C,M,S) :- pg_option(C,M,S).
.decl lc_option(c:number,minmatch:number,margin:number)
lc_option(C,M,4) :- lg_option(C,M,_).
// Exact final-token anchor; choose a uniquely longer conflicting source context.
// Includer supplies tok and lc_option(candidate, minimum_match, minimum_margin).
.decl lc_last(i:number,p:number)
lc_last(I,P) :- tok(I,_,_), P = max Q : { tok(I,Q,_) }.
.decl lc_match(i:number,j:number,k:number)
lc_match(I,J,1) :- lc_last(I,P), tok(I,P,T), tok(I,J,T), J < P.
lc_match(I,J,K+1) :- lc_match(I,J,K), K < 64, lc_last(I,P),
    tok(I,P-K,T), tok(I,J-K,T).
.decl lc_source(i:number,j:number,k:number,t:number)
lc_source(I,J,K,T) :- lc_match(I,J,K), tok(I,J+1,T).
.decl lc_best(i:number,k:number)
lc_best(I,K) :- lc_source(I,_,_,_), K = max L : { lc_source(I,_,L,_) }.
.decl lc_tie(i:number)
lc_tie(I) :- lc_best(I,K), lc_source(I,_,K,T), lc_source(I,_,K,U), T != U.
.decl lc_winner(i:number,t:number)
lc_winner(I,T) :- lc_best(I,K), lc_source(I,_,K,T), !lc_tie(I).
.decl lc_other(i:number,k:number)
lc_other(I,K) :- lc_winner(I,T), lc_source(I,_,K,U), T != U.
.decl lc_runner(i:number,k:number)
lc_runner(I,K) :- lc_other(I,_), K = max L : { lc_other(I,L) }.
.decl lc_frequency(i:number,t:number,n:number)
lc_frequency(I,T,N) :- lc_winner(I,T), N = count : { tok(I,_,T) }.
.decl lc_prediction(c:number,i:number,t:number)
lc_prediction(C,I,T) :- lc_option(C,M,D), lc_best(I,K), K >= M,
    lc_runner(I,R), R >= 3, K-R >= D, lc_winner(I,T), lc_frequency(I,T,1).
.decl lc_recent_position(i:number,j:number)
lc_recent_position(I,J) :- lc_match(I,_,3), J = max Q : { lc_match(I,Q,3) }.
.decl lc_recent(i:number,t:number)
lc_recent(I,T) :- lc_recent_position(I,J), tok(I,J+1,T).

// Includer supplies lc_match/lc_source/lc_best/lc_other/lc_runner/lc_winner
// from copy_longest_runtime.dl, and lg_option(c,minmatch,minsupport).
.decl lg_support_source(c:number,i:number,j:number,t:number)
lg_support_source(C,I,J,T) :- lg_option(C,M,_), lc_winner(I,T), lc_runner(I,R),
    lc_source(I,J,K,T), K >= M, K >= R+4.
.decl lg_support(c:number,i:number,n:number)
lg_support(C,I,N) :- lg_option(C,_,_), lc_winner(I,_),
    N = count : { lg_support_source(C,I,_,_) }.
.decl lg_prediction(c:number,i:number,t:number)
lg_prediction(C,I,T) :- lg_option(C,M,S), lc_best(I,K), K >= M,
    lc_winner(I,T), lc_runner(I,R), R >= 12, K-R >= 4, lg_support(C,I,N), N >= S.

// Includer supplies prior_band(q,t,category), pg_option, and long-consensus rules.
.decl pg_query(i:number,q:number)
pg_query(I,Q) :- lc_last(I,P), tok(I,P,Q).
.decl pg_source(i:number,t:number)
pg_source(I,T) :- lc_source(I,_,K,T), K >= 12.
.decl pg_missing(i:number)
pg_missing(I) :- pg_query(I,Q), pg_source(I,T), !prior_band(Q,T,_).
.decl pg_opposed(i:number,t:number)
pg_opposed(I,T) :- pg_query(I,Q), prior_band(Q,T,B), pg_source(I,U), T != U,
    prior_band(Q,U,C), C <= B.
.decl pg_prediction(c:number,i:number,t:number)
pg_prediction(C,I,T) :- pg_option(C,_,_), lg_prediction(C,I,T), pg_query(I,Q),
    prior_band(Q,T,_), !pg_missing(I), !pg_opposed(I,T).

.decl prior_band(q:number,t:number,b:number)
