.decl tok(i:number,p:number,t:number) .input tok
.decl domain(i:number) .input domain
#include "circuit.dl"
.decl firing(i:number,t:number) .output firing
firing(I,T) :- domain(I), cdecide(I,T).
.decl abstain(i:number) .output abstain
abstain(I) :- domain(I), !cdecide(I,_).
.decl invalid() .output invalid
invalid() :- !domain(_).
invalid() :- cdecide(I,_), !domain(I).
invalid() :- cdecide(I,T), cdecide(I,U), T != U.
.decl certified() .output certified
certified() :- !invalid().
